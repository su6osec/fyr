<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's flame, caught mid-freeze.

    Same silhouette family as the launcher mark: a pointed tip, a full belly,
    and the little curl bitten out of the left edge. What changes is the
    temperature — frost white at the tip cooling down to deep ice at the base,
    with a near-white core where the fire used to be hottest.

    Drawn rather than assembled from emoji because the two glyphs it replaces
    (an ice cube and a flame, side by side) read as a caption, not as a mark:
    the pair is twice as wide as every other day-cell symbol, and neither half
    belongs to Fyr. One shape in Fyr's own drawing is what the grid wanted.

    Fixed colours on purpose: the day number is painted over this in dark ink,
    and it has to hold that contrast on a near-black grid and a near-white one
    without the artwork flexing for either theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Outer flame: tip at the top, belly to the right, curl on the left. -->
    <path android:pathData="M13.7,1.2
        C15.0,4.2 17.4,6.3 18.4,9.7
        C19.6,13.5 17.8,17.5 14.7,19.7
        C13.5,21.0 11.4,21.6 9.3,20.8
        C6.5,19.7 4.7,16.9 4.8,13.9
        C4.9,12.4 6.2,11.4 7.7,11.3
        C6.5,9.8 6.8,8.0 8.1,6.5
        C9.6,4.6 11.7,2.8 13.7,1.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="1.2"
                android:endX="12"
                android:endY="21.6"
                android:startColor="#E4F6FF"
                android:centerColor="#55BCEF"
                android:endColor="#1B74B5" />
        </aapt:attr>
    </path>

    <!-- The cold heart: the inner flame the logo carries in orange, here in
         frost — a plain teardrop with the tip drawn well up the body, so it
         reads as a flame inside the flame rather than a hole in it. Pale,
         because the day's number is read on top of it. -->
    <path android:pathData="M12.4,8.8
        C13.0,11.6 14.7,12.9 14.7,15.4
        C14.7,18.0 12.7,19.9 10.2,19.9
        C7.7,19.9 5.7,18.0 5.7,15.4
        C5.7,13.6 6.7,12.3 8.2,11.5
        C9.5,10.5 11.1,9.8 12.4,8.8 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="11"
                android:startY="8.6"
                android:endX="11"
                android:endY="20.0"
                android:startColor="#F4FCFF"
                android:endColor="#C2EBFF" />
        </aapt:attr>
    </path>
</vector>
